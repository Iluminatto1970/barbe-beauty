RewriteEngine On

# Nunca servir metadados do git nem arquivos de configuracao, dump,
# documentacao ou script (o docroot e a raiz do projeto).
RewriteRule ^\.(git|env|secrets|freebuff) - [F,L]
RewriteRule \.(md|sql|gz|zip|log|ya?ml|sh|bat|ini)$ - [F,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

RewriteRule ^agendamento(.*)$ agendamentos.php [L]
RewriteRule ^agendamentos(.*)$ agendamentos.php [L]
RewriteRule ^agendar(.*)$ agendamentos.php [L]
RewriteRule ^produtos(.*)$ produtos.php [L]
RewriteRule ^servicos(.*)$ servicos.php [L]
RewriteRule ^index(.*)$ index.php [L]
RewriteRule ^index.php(.*)$ index.php [L]
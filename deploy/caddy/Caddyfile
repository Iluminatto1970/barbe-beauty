{
	on_demand_tls {
		ask http://127.0.0.1:4010/api/host-check
	}
	auto_https disable_redirects
}

# agreste.shop (deploy em /opt/agreste)
import /opt/agreste/deploy/Caddyfile.agreste

# beauty: HTTP sempre vai para HTTPS (landing)
http://beauty.iluminatto.online {
	redir https://beauty.iluminatto.online{uri} permanent
}

beauty.iluminatto.online {
	root * /var/www/beauty
	encode gzip
	php_fastcgi unix//run/php/php8.4-fpm.sock {
		try_files {path} {path}.php {path}/index.php index.php
	}
	@sensivel path_regexp (?i)(^/[.][^/]+|^/(caddy|docker)file$|[.](md|ya?ml|sql|gz|zip|log|sh|bat|ini|env|json|lock|bak|old|orig|swp)$)
	respond @sensivel 404
	file_server
}

# Deskcomm CRM (app 127.0.0.1:3005 + Supabase gateway 127.0.0.1:8000)
crm.iluminatto.online, crm.claudeapi.space {
	encode gzip
	@supabase path /auth/v1* /rest/v1* /storage/v1* /realtime/v1* /functions/v1* /graphql/v1*
	handle @supabase {
		reverse_proxy 127.0.0.1:8000
	}
	handle {
		reverse_proxy 127.0.0.1:3005
	}
}

import /etc/caddy/sites/*.caddy


# Dominio principal do SaaS (barbearias e saloes): a raiz serve a landing, o
# login, os planos, o autocadastro e o super admin. Cada estabelecimento vive
# no seu subdominio {slug}.iluminatto.online.
#
# Mesmo padrao do agreste.shop (import acima): HTTPS explicito e emissao por
# TLS-ALPN. O bloco global desta VPS tem `auto_https disable_redirects` e o
# 80 -> 443 e um redir fixo, entao o desafio HTTP-01 nunca chega ao Caddy;
# desabilitar o HTTP-01 evita retentativas inuteis e usa o caminho que ja
# emite os certificados do curinga.
https://iluminatto.online {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	root * /var/www/beauty
	encode gzip
	php_fastcgi unix//run/php/php8.4-fpm.sock {
		try_files {path} {path}.php {path}/index.php index.php
	}
	@sensivel path_regexp (?i)(^/[.][^/]+|^/(caddy|docker)file$|[.](md|ya?ml|sql|gz|zip|log|sh|bat|ini|env|json|lock|bak|old|orig|swp)$)
	respond @sensivel 404
	file_server
}

# www e apenas apelido da raiz.
https://www.iluminatto.online {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	redir https://iluminatto.online{uri} permanent
}

http://iluminatto.online, http://www.iluminatto.online {
	redir https://iluminatto.online{uri} permanent
}

{
	on_demand_tls {
		ask http://127.0.0.1:4010/api/host-check
	}
	auto_https disable_redirects
}

# agreste.shop (deploy em /opt/agreste)
import /opt/agreste/deploy/Caddyfile.agreste

# beauty: HTTP sempre vai para HTTPS (landing)
http://beauty.iluminatto.online {
	redir https://beauty.iluminatto.online{uri} permanent
}

beauty.iluminatto.online {
	root * /var/www/beauty
	encode gzip
	php_fastcgi unix//run/php/php8.4-fpm.sock {
		try_files {path} {path}.php {path}/index.php index.php
	}
	@sensivel path_regexp (?i)(^/[.][^/]+|^/(caddy|docker)file$|[.](md|ya?ml|sql|gz|zip|log|sh|bat|ini|env|json|lock|bak|old|orig|swp)$)
	respond @sensivel 404
	file_server
}

# Deskcomm CRM (app 127.0.0.1:3005 + Supabase gateway 127.0.0.1:8000)
crm.iluminatto.online, crm.claudeapi.space {
	encode gzip
	@supabase path /auth/v1* /rest/v1* /storage/v1* /realtime/v1* /functions/v1* /graphql/v1*
	handle @supabase {
		reverse_proxy 127.0.0.1:8000
	}
	handle {
		reverse_proxy 127.0.0.1:3005
	}
}

import /etc/caddy/sites/*.caddy


# iluminatto.online e o endereco ANTIGO do SaaS: a raiz e o www respondem
# 301 para o dominio atual (beautypro.site). Os subdominios antigos dos
# clientes (*.iluminatto.online) fazem o mesmo pelo gerador em
# /etc/caddy/sites/ (beauty-sync-tenants.php). A excecao e
# beauty.iluminatto.online, que continua servindo a instalacao principal no
# bloco proprio acima.
#
# Mesmo padrao do agreste.shop (import acima): HTTPS explicito e emissao por
# TLS-ALPN. O bloco global desta VPS tem `auto_https disable_redirects` e o
# 80 -> 443 e um redir fixo, entao o desafio HTTP-01 nunca chega ao Caddy;
# desabilitar o HTTP-01 evita retentativas inuteis e usa o caminho que ja
# emite os certificados do curinga. O TLS fica no bloco justamente para o
# certificado antigo continuar sendo renovado: sem ele o 301 nem chegaria a
# ser servido em https.
https://iluminatto.online {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	redir https://beautypro.site{uri} permanent
}

# www e apenas apelido: vai direto para a raiz do dominio novo, sem um
# segundo salto por www.beautypro.site.
https://www.iluminatto.online {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	redir https://beautypro.site{uri} permanent
}

http://iluminatto.online, http://www.iluminatto.online {
	redir https://beautypro.site{uri} permanent
}

# beautypro.site: dominio principal novo do SaaS. Mesmo desenho da raiz do
# iluminatto.online (e do agreste.shop): HTTPS explicito e emissao por
# TLS-ALPN, porque o bloco global desabilita o redirect automatico e o
# 80 -> 443 e um redir fixo, entao o HTTP-01 nunca chega ao Caddy. Os
# subdominios dos clientes ({slug}.beautypro.site) vem de /etc/caddy/sites/,
# gerados pelo beauty-sync-tenants.php.
https://beautypro.site {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	root * /var/www/beauty
	encode gzip
	php_fastcgi unix//run/php/php8.4-fpm.sock {
		try_files {path} {path}.php {path}/index.php index.php
	}
	@sensivel path_regexp (?i)(^/[.][^/]+|^/(caddy|docker)file$|[.](md|ya?ml|sql|gz|zip|log|sh|bat|ini|env|json|lock|bak|old|orig|swp)$)
	respond @sensivel 404
	file_server
}

https://www.beautypro.site {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	redir https://beautypro.site{uri} permanent
}

http://beautypro.site, http://www.beautypro.site {
	redir https://beautypro.site{uri} permanent
}

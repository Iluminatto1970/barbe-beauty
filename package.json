{
  "name": "barbearia-pro",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo Barbearia PRO (Fase 0): apps/web (Next.js 19) + apps/api (Fastify) + packages/domain, db, ui",
  "packageManager": "pnpm@10.6.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev:web": "pnpm --filter @barbearia/web dev",
    "dev:api": "pnpm --filter @barbearia/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "audit": "pnpm audit --prod"
  },
  "devDependencies": {
    "next": "^16.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "@clerk/shared"]
  }
}

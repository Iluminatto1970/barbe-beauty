{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "Design tokens Barbearia PRO — dark + dourado (portados de app/css/style.css). Fonte da verdade: gere src/tokens.css com `pnpm --filter @barbearia/ui tokens`.",
  "primitive": {
    "color": {
      "$description": "Valores crus — paleta da marca e neutros do tema escuro/claro.",
      "gold": {
        "300": { "$value": "#F0CD7F", "$type": "color", "$description": "dourado claro (gradientes, hover)" },
        "500": { "$value": "#D4AF37", "$type": "color", "$description": "dourado da marca (--bp-dourado)" },
        "900": { "$value": "#171204", "$type": "color", "$description": "dourado escuro — texto sobre dourado (--bp-dourado-escuro)" }
      },
      "dark": {
        "50": { "$value": "#FFFFFF", "$type": "color" },
        "200": { "$value": "#FEFEFE", "$type": "color" },
        "300": { "$value": "#E8E8E8", "$type": "color" },
        "400": { "$value": "#999999", "$type": "color" },
        "500": { "$value": "#9A9A9A", "$type": "color" },
        "600": { "$value": "#3D3D3D", "$type": "color" },
        "700": { "$value": "#1C1C1C", "$type": "color" },
        "750": { "$value": "#1A1A1A", "$type": "color" },
        "800": { "$value": "#111111", "$type": "color" },
        "850": { "$value": "#0A0A0A", "$type": "color" },
        "900": { "$value": "#0D0D0D", "$type": "color" },
        "950": { "$value": "#070707", "$type": "color" }
      },
      "light": {
        "100": { "$value": "#F4F2EC", "$type": "color" },
        "200": { "$value": "#FFFFFF", "$type": "color" },
        "300": { "$value": "#ECE8E0", "$type": "color" },
        "400": { "$value": "#E2DDD2", "$type": "color" },
        "500": { "$value": "#8A8578", "$type": "color" },
        "700": { "$value": "#3A3833", "$type": "color" },
        "800": { "$value": "#1E1D1B", "$type": "color" },
        "900": { "$value": "#171204", "$type": "color" }
      },
      "red": {
        "500": { "$value": "#E05252", "$type": "color", "$description": "vermelho de erro do wizard (era hex hardcoded no apps/web)" }
      }
    },
    "fontFamily": {
      "sans": { "$value": "'Poppins', system-ui, -apple-system, sans-serif", "$type": "fontFamily", "$description": "fonte do corpo (--bp-font-sans)" },
      "serif": { "$value": "'Playfair Display', 'Poppins', Georgia, serif", "$type": "fontFamily", "$description": "fonte de títulos (--bp-font-serif)" }
    },
    "fontSize": {
      "xs": { "$value": "0.75rem", "$type": "dimension" },
      "sm": { "$value": "0.9375rem", "$type": "dimension", "$description": "15px — botões (fiel ao legado)" },
      "base": { "$value": "1rem", "$type": "dimension" },
      "lg": { "$value": "1.125rem", "$type": "dimension" },
      "xl": { "$value": "1.25rem", "$type": "dimension" },
      "2xl": { "$value": "1.5rem", "$type": "dimension" },
      "3xl": { "$value": "1.875rem", "$type": "dimension" },
      "4xl": { "$value": "2.25rem", "$type": "dimension" }
    },
    "spacing": {
      "0": { "$value": "0", "$type": "dimension" },
      "1": { "$value": "0.25rem", "$type": "dimension" },
      "2": { "$value": "0.5rem", "$type": "dimension" },
      "3": { "$value": "0.75rem", "$type": "dimension" },
      "4": { "$value": "1rem", "$type": "dimension" },
      "5": { "$value": "1.25rem", "$type": "dimension" },
      "6": { "$value": "1.5rem", "$type": "dimension" },
      "8": { "$value": "2rem", "$type": "dimension" },
      "10": { "$value": "2.5rem", "$type": "dimension" },
      "12": { "$value": "3rem", "$type": "dimension" },
      "16": { "$value": "4rem", "$type": "dimension" },
      "buttonX": { "$value": "2.8125rem", "$type": "dimension", "$description": "45px — padding horizontal do botão (fiel ao legado)" },
      "buttonY": { "$value": "0.625rem", "$type": "dimension", "$description": "10px — padding vertical do botão (fiel ao legado)" }
    },
    "radius": {
      "none": { "$value": "0", "$type": "dimension", "$description": "estética reta do legado" },
      "sm": { "$value": "0.125rem", "$type": "dimension" },
      "default": { "$value": "0.25rem", "$type": "dimension" },
      "md": { "$value": "0.375rem", "$type": "dimension" },
      "lg": { "$value": "0.5rem", "$type": "dimension" },
      "xl": { "$value": "0.75rem", "$type": "dimension" },
      "full": { "$value": "9999px", "$type": "dimension" }
    },
    "shadow": {
      "none": { "$value": "none", "$type": "shadow" },
      "sm": { "$value": "0 1px 2px 0 rgb(0 0 0 / 0.05)", "$type": "shadow" },
      "default": { "$value": "0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1)", "$type": "shadow" },
      "md": { "$value": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)", "$type": "shadow" },
      "lg": { "$value": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)", "$type": "shadow" }
    },
    "duration": {
      "fast": { "$value": "150ms", "$type": "duration" },
      "normal": { "$value": "200ms", "$type": "duration" },
      "slow": { "$value": "300ms", "$type": "duration", "$description": "0.3s — transição do botão (fiel ao legado)" }
    }
  },
  "semantic": {
    "$description": "Aliases de propósito. Tema padrão = escuro (o legado). O bloco `dark.semantic` abaixo é o par claro [data-theme='claro'].",
    "color": {
      "background": { "$value": "{primitive.color.dark.950}", "$type": "color", "$description": "fundo da página (--bp-fundo)" },
      "background-subtle": { "$value": "{primitive.color.dark.900}", "$type": "color", "$description": "seções suaves (--bp-fundo-suave)" },
      "background-raised": { "$value": "{primitive.color.dark.800}", "$type": "color", "$description": "cards (--bp-fundo-card)" },
      "background-input": { "$value": "{primitive.color.dark.750}", "$type": "color", "$description": "inputs (--bp-fundo-input)" },
      "background-input-2": { "$value": "{primitive.color.dark.700}", "$type": "color", "$description": "inputs alt (--bp-fundo-input-2)" },
      "background-info": { "$value": "{primitive.color.dark.850}", "$type": "color", "$description": "faixas de aviso (--bp-fundo-info)" },
      "foreground": { "$value": "{primitive.color.dark.300}", "$type": "color", "$description": "texto principal (--bp-texto)" },
      "foreground-strong": { "$value": "{primitive.color.dark.50}", "$type": "color", "$description": "títulos/nav (--bp-texto-forte, --bp-texto-nav)" },
      "foreground-soft": { "$value": "{primitive.color.dark.200}", "$type": "color", "$description": "texto suave (--bp-texto-suave)" },
      "foreground-muted": { "$value": "{primitive.color.dark.500}", "$type": "color", "$description": "texto fraco (--bp-texto-fraco)" },
      "foreground-faint": { "$value": "{primitive.color.dark.400}", "$type": "color", "$description": "texto apagado (--bp-texto-apagado)" },
      "primary": { "$value": "{primitive.color.gold.500}", "$type": "color", "$description": "dourado da marca (--bp-dourado)" },
      "primary-hover": { "$value": "{primitive.color.gold.300}", "$type": "color", "$description": "dourado claro (--bp-dourado-claro)" },
      "primary-foreground": { "$value": "{primitive.color.gold.900}", "$type": "color", "$description": "texto sobre dourado (--bp-dourado-escuro)" },
      "border": { "$value": "{primitive.color.dark.600}", "$type": "color", "$description": "bordas (--bp-borda)" },
      "destructive": { "$value": "{primitive.color.red.500}", "$type": "color", "$description": "erros/alerta — novo, não existia no legado" },
      "destructive-foreground": { "$value": "{primitive.color.light.200}", "$type": "color", "$description": "texto sobre fundo destrutivo" }
    },
    "font": {
      "sans": { "$value": "{primitive.fontFamily.sans}", "$type": "fontFamily" },
      "serif": { "$value": "{primitive.fontFamily.serif}", "$type": "fontFamily" }
    },
    "space": {
      "component": { "$value": "{primitive.spacing.4}", "$type": "dimension" },
      "section": { "$value": "{primitive.spacing.12}", "$type": "dimension" }
    },
    "bp": {
      "$description": "Aliases de compatibilidade com a nomenclatura legada (--bp-*) — apps/web consome estes. Não criar novos usos; preferir os tokens semânticos.",
      "fundo": { "$value": "{semantic.color.background}", "$type": "color" },
      "fundo-suave": { "$value": "{semantic.color.background-subtle}", "$type": "color" },
      "fundo-card": { "$value": "{semantic.color.background-raised}", "$type": "color" },
      "fundo-input": { "$value": "{semantic.color.background-input}", "$type": "color" },
      "fundo-input-2": { "$value": "{semantic.color.background-input-2}", "$type": "color" },
      "fundo-info": { "$value": "{semantic.color.background-info}", "$type": "color" },
      "texto": { "$value": "{semantic.color.foreground}", "$type": "color" },
      "texto-forte": { "$value": "{semantic.color.foreground-strong}", "$type": "color" },
      "texto-nav": { "$value": "{semantic.color.foreground-strong}", "$type": "color" },
      "texto-suave": { "$value": "{semantic.color.foreground-soft}", "$type": "color" },
      "texto-fraco": { "$value": "{semantic.color.foreground-muted}", "$type": "color" },
      "texto-apagado": { "$value": "{semantic.color.foreground-faint}", "$type": "color" },
      "borda": { "$value": "{semantic.color.border}", "$type": "color" },
      "dourado": { "$value": "{semantic.color.primary}", "$type": "color" },
      "dourado-claro": { "$value": "{semantic.color.primary-hover}", "$type": "color" },
      "dourado-escuro": { "$value": "{semantic.color.primary-foreground}", "$type": "color" },
      "font-sans": { "$value": "{semantic.font.sans}", "$type": "fontFamily" },
      "font-serif": { "$value": "{semantic.font.serif}", "$type": "fontFamily" }
    }
  },
  "component": {
    "$description": "Tokens por componente — o CSS dos componentes só referencia estes.",
    "button": {
      "bg": { "$value": "{semantic.color.primary}", "$type": "color" },
      "fg": { "$value": "{semantic.color.primary-foreground}", "$type": "color" },
      "border": { "$value": "{semantic.color.primary}", "$type": "color" },
      "hover-bg": { "$value": "transparent", "$type": "color", "$description": "fiel ao legado (.bp-btn:hover)" },
      "hover-fg": { "$value": "{semantic.color.primary}", "$type": "color" },
      "secondary-bg": { "$value": "transparent", "$type": "color", "$description": "fiel ao legado (.bp-btn--secundario)" },
      "secondary-fg": { "$value": "{semantic.color.primary}", "$type": "color" },
      "secondary-hover-bg": { "$value": "{semantic.color.primary}", "$type": "color" },
      "secondary-hover-fg": { "$value": "{semantic.color.primary-foreground}", "$type": "color" },
      "padding-x": { "$value": "{primitive.spacing.buttonX}", "$type": "dimension" },
      "padding-y": { "$value": "{primitive.spacing.buttonY}", "$type": "dimension" },
      "font-size": { "$value": "{primitive.fontSize.sm}", "$type": "dimension" },
      "radius": { "$value": "{primitive.radius.none}", "$type": "dimension" },
      "duration": { "$value": "{primitive.duration.slow}", "$type": "duration" }
    },
    "input": {
      "bg": { "$value": "{semantic.color.background-input}", "$type": "color" },
      "fg": { "$value": "{semantic.color.foreground}", "$type": "color" },
      "border": { "$value": "{semantic.color.border}", "$type": "color" },
      "focus-ring": { "$value": "{semantic.color.primary}", "$type": "color" },
      "padding-x": { "$value": "{primitive.spacing.3}", "$type": "dimension" },
      "padding-y": { "$value": "{primitive.spacing.2}", "$type": "dimension" },
      "radius": { "$value": "{primitive.radius.none}", "$type": "dimension" },
      "font-size": { "$value": "{primitive.fontSize.base}", "$type": "dimension" }
    },
    "card": {
      "bg": { "$value": "{semantic.color.background-raised}", "$type": "color" },
      "border": { "$value": "{semantic.color.border}", "$type": "color" },
      "shadow": { "$value": "{primitive.shadow.none}", "$type": "shadow" },
      "padding": { "$value": "{primitive.spacing.6}", "$type": "dimension" },
      "radius": { "$value": "{primitive.radius.none}", "$type": "dimension" }
    }
  },
  "dark": {
    "$description": "Par de tema CLARO (o legado chama `[data-theme='claro']`; o gerador emite `.dark`, o script local ajusta o seletor). O padrão é o tema escuro no :root.",
    "semantic": {
      "color": {
        "background": { "$value": "{primitive.color.light.100}", "$type": "color" },
        "background-subtle": { "$value": "{primitive.color.light.200}", "$type": "color" },
        "background-raised": { "$value": "{primitive.color.light.200}", "$type": "color" },
        "background-input": { "$value": "{primitive.color.light.200}", "$type": "color" },
        "background-input-2": { "$value": "{primitive.color.light.200}", "$type": "color" },
        "background-info": { "$value": "{primitive.color.light.300}", "$type": "color" },
        "foreground": { "$value": "{primitive.color.light.800}", "$type": "color" },
        "foreground-strong": { "$value": "{primitive.color.light.900}", "$type": "color" },
        "foreground-soft": { "$value": "{primitive.color.light.700}", "$type": "color" },
        "foreground-muted": { "$value": "{primitive.color.light.500}", "$type": "color" },
        "foreground-faint": { "$value": "{primitive.color.light.500}", "$type": "color" },
        "border": { "$value": "{primitive.color.light.400}", "$type": "color" }
      },
      "bp": {
        "fundo": { "$value": "{dark.semantic.color.background}", "$type": "color" },
        "fundo-suave": { "$value": "{dark.semantic.color.background-subtle}", "$type": "color" },
        "fundo-card": { "$value": "{dark.semantic.color.background-raised}", "$type": "color" },
        "fundo-input": { "$value": "{dark.semantic.color.background-input}", "$type": "color" },
        "fundo-input-2": { "$value": "{dark.semantic.color.background-input-2}", "$type": "color" },
        "fundo-info": { "$value": "{dark.semantic.color.background-info}", "$type": "color" },
        "texto": { "$value": "{dark.semantic.color.foreground}", "$type": "color" },
        "texto-forte": { "$value": "{dark.semantic.color.foreground-strong}", "$type": "color" },
        "texto-nav": { "$value": "#FFFFFF", "$type": "color", "$description": "fiel ao legado: nav permanece branca no tema claro" },
        "texto-suave": { "$value": "{dark.semantic.color.foreground-soft}", "$type": "color" },
        "texto-fraco": { "$value": "{dark.semantic.color.foreground-muted}", "$type": "color" },
        "texto-apagado": { "$value": "{dark.semantic.color.foreground-faint}", "$type": "color" },
        "borda": { "$value": "{dark.semantic.color.border}", "$type": "color" }
      }
    }
  }
}
